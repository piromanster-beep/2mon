MONGO_URI=mongodb://localhost:27017
MAX_BOT_TOKEN=your_bot_token_here
# MAX Bot API. MAX рекомендует platform-api2.max.ru вместо platform-api.max.ru,
# но для platform-api2 нужен корневой сертификат Минцифры в доверенных (см. deploy/HTTPS.md).
MAX_API_URL=https://platform-api.max.ru
ADMIN_PASSWORD=change_me
RATE_LIMIT=30
QUEUE_SIZE=1000
# Сколько дней хранить журнал отправок (messages_log). 0 или меньше — вечно.
LOG_RETENTION_DAYS=180
PORT=8080
